# Public client configuration (safe to expose: access is enforced by the database functions, not by this key).
# Copy to .env.local for local development, or set these in your hosting provider (e.g. Vercel project settings).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Optional. Set to "off" to disable Realtime pings and rely on polling only.
# VITE_REALTIME=on
